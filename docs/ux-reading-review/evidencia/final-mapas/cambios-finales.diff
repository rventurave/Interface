+
+/* Keep map tools outside the drawing area without changing pan or zoom handlers. */
+.map-frame {
+  --map-tools-space: 60px;
+  position: relative;
+  padding-bottom: var(--map-tools-space);
+  background: linear-gradient(to top, #100c18 var(--map-tools-space), #050505 var(--map-tools-space));
+}
+
+.map-frame--profile {
+  --map-tools-space: 104px;
+}
+
+.map-frame > .react-flow {
+  /* React Flow writes overflow:hidden inline; only its tools may leave the canvas. */
+  overflow: visible !important;
+}
+
+.map-frame .react-flow__renderer {
+  overflow: hidden;
+}
+
+.map-frame .react-flow__panel.react-flow__controls {
+  bottom: calc(12px - var(--map-tools-space));
+  left: 12px;
+  margin: 0;
+  flex-direction: row;
+}
+
+.map-frame .react-flow__panel.react-flow__minimap {
+  bottom: calc(12px - var(--map-tools-space));
+  right: 12px;
+  margin: 0;
+}
+
+.map-node-label {
+  overflow-wrap: anywhere;
+  border-radius: 6px;
+  background: #14101f;
+  padding: 3px 5px;
+}
+
+.react-flow__node:has(.map-interactive-node) {
+  cursor: pointer;
+}
+
+.react-flow__node-profile {
+  cursor: grab;
+}
+
+.react-flow__node-profile.dragging {
+  cursor: grabbing;
+}
+
+.map-frame .react-flow__node.selectable:focus-visible {
+  outline: 2px solid #c4b5fd;
+  outline-offset: 4px;
+  border-radius: 10px;
+}
+
+.react-flow__node:has(.map-interactive-node):hover > .map-interactive-node,
+.react-flow__node-profile:hover > .map-profile-node {
+  outline: 1px solid #c4b5fd;
+  outline-offset: 3px;
+  border-radius: 10px;
+}
